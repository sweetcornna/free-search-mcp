# free-search-mcp configuration — copy to `.env` and edit.
# Every setting is optional; the defaults below are the built-in ones.
# All variables are prefixed with SEARCH_MCP_.
# Comments go on their own line: a trailing `# note` after a value is read as
# part of the value.
#
# Where this file can live (highest precedence first):
#   1. real environment variables
#   2. ./.env in the directory the server is launched from (source checkouts)
#   3. ~/.config/search-mcp/.env — stable location for uvx/PyPI installs
#      (override the directory with SEARCH_MCP_CONFIG_DIR)

# --- Engines -----------------------------------------------------------------
# Nothing in any pool below needs an API key.
#
# JSON list: the pool a search uses when it names no engines. All plain HTTP,
# no browser. `mojeek` was captcha-walled on every request when measured
# (2026-09-21); it stays for its independent index, and in practice the circuit
# breaker benches it after one attempt and re-probes it later.
SEARCH_MCP_DEFAULT_ENGINES=["duckduckgo","bing","anysearch","mojeek"]
# Stand-ins, in order, seated ONLY while fewer than MIN_HEALTHY_ENGINES general
# engines are healthy. `brave` needs Chromium and is skipped without it.
SEARCH_MCP_RESERVE_ENGINES=["so360","brave","searx"]
SEARCH_MCP_MIN_HEALTHY_ENGINES=3
# Joined for freshness="day"|"week" (category="news" routes to googlenews on
# its own). googlenews is no longer a default: it answered every query,
# programming questions included, with ten news headlines.
SEARCH_MCP_FRESH_ENGINES=["googlenews"]
# JSON object: engines joined when the QUERY is written in that language
# (detected from its script, not from SEARCH_MCP_REGION).
SEARCH_MCP_LOCALE_ENGINES={"zh":["so360"]}
# Other keyless engines run when a call names them: "startpage","baidu",
#   "google","serpsearch","bilibili","zhihu","sogou","wikipedia","openlibrary".
# Vertical sources are selected automatically by `category=` and normally do
# NOT belong in a pool: "arxiv","openalex","crossref","pubmed" (paper),
#   "github","stackexchange","hackernews" (github/forum), "gdelt" (news),
#   "openverse" (image), "zenodo" (dataset).
# Adding them to the default pool makes EVERY search pay for them.
SEARCH_MCP_MAX_RESULTS_PER_ENGINE=10
# Pin known-good SearXNG instance(s) (comma/space separated). When set, they
# take precedence over the built-in shortlist the searx engine races. searx is
# a reserve and a rescue engine, so a live instance here re-arms both.
# SEARCH_MCP_SEARX_INSTANCES=https://searx.be https://priv.au

# --- Engine health (circuit breaker) -------------------------------------------
# A walled or off-topic engine is benched at once, an erroring one after 2
# failures in a row, a silently empty one after 3. The bench starts at
# COOLDOWN_SECONDS and doubles on each repeat up to the maximum; one success
# clears it. Naming an engine in `engines=[...]` always runs it.
SEARCH_MCP_HEALTH_ENABLED=true
SEARCH_MCP_ENGINE_COOLDOWN_SECONDS=600
SEARCH_MCP_ENGINE_COOLDOWN_MAX_SECONDS=3600
# Drop a web engine's whole bucket when its results mention nothing of the
# query beyond the first word WHILE another engine's do (Bing's decoy page).
# Reported as gated reason "off_topic"; not a block, a proxy does not help.
SEARCH_MCP_COHERENCE_GUARD_ENABLED=true

# --- Downloads ---------------------------------------------------------------
# Enabled by default. Set false for an explicit opt-out.
SEARCH_MCP_DOWNLOAD_ENABLED=true
# Optional destination override. Unset or blank follows SEARCH_MCP_CACHE_DIR:
# ~/.cache/search-mcp/downloads by default, /data/downloads in Docker.
# SEARCH_MCP_DOWNLOAD_DIR=~/.cache/search-mcp/downloads
# Downloads are ephemeral: anything older than this is deleted before the next
# download and at startup. 0 keeps files forever.
SEARCH_MCP_DOWNLOAD_TTL_HOURS=24
# Second-layer save cap. The effective remote cap is the smaller of this and
# SEARCH_MCP_MAX_RESPONSE_BYTES (25,000,000 bytes by default).
SEARCH_MCP_DOWNLOAD_MAX_MB=100

# --- Transport ---------------------------------------------------------------
# stdio (default) needs no port and is what MCP client configs expect.
# streamable-http serves the same tools over HTTP; protocol revision
# 2026-07-28 is stateless, so replicas need no session affinity.
# SEARCH_MCP_TRANSPORT=stdio
# SEARCH_MCP_HTTP_HOST=127.0.0.1
# SEARCH_MCP_HTTP_PORT=8000
# SEARCH_MCP_HTTP_PATH=/mcp
# The HTTP endpoint is UNAUTHENTICATED and will fetch arbitrary URLs for
# whoever reaches it. Binding anything other than loopback means putting an
# authenticating proxy in front. Loopback origins are always accepted; add
# others here (comma/space separated) for browser-based clients.
# SEARCH_MCP_HTTP_ALLOWED_ORIGINS=https://my-client.example

# --- Category routing --------------------------------------------------------
# When a search passes `category=` but not `engines=`, this many category-native
# engines are added to the pool. 0 disables the routing and restores pure
# default-pool behavior.
#
# A bare group ("paper", "finance") round-robins across its sub-groups before
# this cap truncates, so three slots buy three DIFFERENT corpora rather than
# three overlapping ones. A dotted sub-group ("paper.biomed") routes to just
# the sources that index it and rarely hits the cap at all.
# SEARCH_MCP_CATEGORY_ENGINE_LIMIT=3
# Without a category, the record sources that claim a question ("100 usd to
# cny", "CVE-2024-3094", "上海明天天气", "latest fastapi version") join the pool
# on their own, at most this many, in registry order. They answer in well
# under a second and run beside the web engines.
# SEARCH_MCP_AUTO_ROUTE_ENABLED=true
# SEARCH_MCP_CLAIM_ENGINE_LIMIT=3
# How long a search waits for its slowest engine once at least one engine has
# answered with results. The pool answers in 2 to 4 s; the tail was one
# browser-rendered engine at 15 s or more. Cancelled engines are reported as
# timed out. 0 disables the deadline.
# SEARCH_MCP_SEARCH_DEADLINE_SECONDS=10
# OpenAlex / Crossref / NCBI route identified callers to a faster pool. Optional.
# SEARCH_MCP_CONTACT_EMAIL=you@example.com

# --- Rate limits (per minute) ------------------------------------------------
# Global default. Engines that publish a stricter rule (gdelt: one request per
# few seconds) declare their own and are SKIPPED rather than queued when their
# token isn't ready — one slow source must not delay a parallel search.
SEARCH_MCP_RATE_LIMIT_PER_MINUTE=30
SEARCH_MCP_FETCH_RATE_LIMIT_PER_MINUTE=20

# --- Cache -------------------------------------------------------------------
# SEARCH_MCP_CACHE_DIR=~/.cache/search-mcp
# 7 days. Searches that asked for recency expire sooner regardless:
# freshness=day 1h, week 6h, month 24h; category=news 6h.
SEARCH_MCP_CACHE_TTL_SECONDS=604800
# Size cap on the cache file, in MB; 0 disables.
SEARCH_MCP_CACHE_MAX_MB=512

# --- Keyless rescue ------------------------------------------------------------
# When a search comes back empty (or nearly empty with unhealthy engines),
# one bounded recovery pass runs via the reserves and then these engines, in
# order, skipping whatever already ran or is benched; first hit wins.
SEARCH_MCP_RESCUE_ENABLED=true
SEARCH_MCP_RESCUE_ENGINES=["searx","bing"]
SEARCH_MCP_RESCUE_TIMEOUT=10.0

# --- Fetch / browser ---------------------------------------------------------
# auto | http | browser
SEARCH_MCP_FETCH_STRATEGY=auto
SEARCH_MCP_BROWSER_HEADLESS=true
SEARCH_MCP_BROWSER_POOL_SIZE=2
SEARCH_MCP_MAX_CONTENT_CHARS=50000
SEARCH_MCP_REQUEST_TIMEOUT=15.0
SEARCH_MCP_FETCH_TIMEOUT=25.0

# --- Locale ------------------------------------------------------------------
# strict | moderate | off
SEARCH_MCP_SAFESEARCH=moderate
# 'cc-lang' token, e.g. us-en, uk-en
SEARCH_MCP_REGION=us-en
SEARCH_MCP_ACCEPT_LANGUAGE=en-US,en;q=0.9
# UA for the httpx paths (documents/structured) and the Playwright browser
# contexts. The curl_cffi engine/fetch path ignores this — its UA comes from
# the impersonated Chrome build so the TLS fingerprint and UA stay consistent.
# SEARCH_MCP_USER_AGENT=Mozilla/5.0 (...) Chrome/131.0.0.0 Safari/537.36

# --- Local settings page (`search-mcp-admin`) ----------------------------------
# Bilingual, loopback-only page for the proxy below (and the optional keys at
# the end of this file). Values saved there live in <config dir>/config.json
# (0600); environment variables override them.
# SEARCH_MCP_CONFIG_DIR=~/.config/search-mcp
# SEARCH_MCP_ADMIN_PORT=8765
# Set to 1 to stop `search-mcp-admin` from auto-opening a browser tab:
# SEARCH_MCP_ADMIN_NO_BROWSER=1

# --- Proxy (fixes datacenter-IP CAPTCHA gating) ------------------------------
# Route outbound traffic (HTTP engines + browser + fetch) through a proxy so
# Google/Bing/Zhihu work from a non-blocked/residential IP. Also settable on the
# local settings page, "Network / Proxy" card. http/https/socks5, optional
# user:pass@.
# SEARCH_MCP_PROXY=http://user:pass@host:port
# Optional: route ONLY these engines through the proxy (blank = all engines):
# SEARCH_MCP_PROXY_ENGINES=google bing zhihu

# --- Safety / sandbox --------------------------------------------------------
# Allow connecting to private/loopback/reserved IPs (SSRF guard escape hatch).
# Turning this ON gives up EVERY check, loopback and cloud metadata included.
# If you are here because the guard refuses every fetch on a proxied or
# fake-IP-VPN network, that is fixed — see the setting below, and leave this
# one alone.
SEARCH_MCP_ALLOW_PRIVATE_HOSTS=false
# When the guard resolves the hostname and checks every A/AAAA record:
#   auto   (default) only when THIS process's resolver decides the destination.
#          Skipped behind an outbound proxy, and on a fake-IP VPN (Clash/Surge/
#          sing-box TUN) that maps every hostname into e.g. 198.18.0.0/15 — in
#          both cases the address resolved here is not the one connected to.
#          Detected from canary hostnames; it can only ever stand down for
#          tunnel ranges, never for loopback, link-local or RFC1918.
#   always run it regardless. Correct only where local DNS matches the egress
#          path; on the two setups above it refuses every fetch.
#   never  skip it entirely.
# Scheme, address-literal and internal-hostname checks run in EVERY mode, so no
# value here opens loopback or a metadata endpoint.
# SEARCH_MCP_SSRF_RESOLVE_ADDRESSES=auto
# Enable local-file reads in read_doc by pointing this at a directory (opt-in).
# SEARCH_MCP_DOCUMENT_ROOT=/path/to/allowed/docs
SEARCH_MCP_MAX_RESPONSE_BYTES=25000000
SEARCH_MCP_MAX_PDF_PAGES=200
SEARCH_MCP_MAX_DOCUMENT_CHARS=2000000

SEARCH_MCP_LOG_LEVEL=INFO

# --- Optional: tool list and the answer agent ----------------------------------
# Register only these tools (comma or space separated). Empty registers all 11.
# SEARCH_MCP_TOOLS=search,fetch,read_doc
#
# The answer agent is OFF by default, and while it is off the `ask` tool does
# not exist. Search never needs a key in any mode. These settings only say
# which language model, if any, turns the pages search found into a short
# answer. A host with its own subagents (Claude Code, Codex) needs none of
# this: see "Delegating a lookup" in the README.
#   api          an OpenAI-compatible or Anthropic-compatible endpoint you name
#   claude-code  one headless `claude -p` run, on your Claude Code login
#   codex        one `codex exec` run in a read-only sandbox
# SEARCH_MCP_AGENT_BACKEND=off
# SEARCH_MCP_AGENT_MODEL=                 # required for api; empty = haiku / the Codex default
# SEARCH_MCP_AGENT_API_PROTOCOL=openai    # openai | anthropic
# SEARCH_MCP_AGENT_API_BASE_URL=          # e.g. http://localhost:11434/v1 (Ollama, no key)
# SEARCH_MCP_AGENT_API_KEY=               # that endpoint's own credential, if it has one
# SEARCH_MCP_AGENT_COMMAND=               # full path of claude / codex when PATH is short
# SEARCH_MCP_AGENT_CLI_ARGS=              # replaces the default flags; for Codex keep --ignore-user-config
# SEARCH_MCP_AGENT_DEPTH=3                # pages read before the model is called
# SEARCH_MCP_AGENT_READ_SECONDS=8         # time those reads share; a slower page is left out
# SEARCH_MCP_AGENT_MAX_STEPS=1            # tool rounds after that; 0 = answer from those pages only
# SEARCH_MCP_AGENT_MAX_SOURCE_CHARS=6000
# SEARCH_MCP_AGENT_TIMEOUT_SECONDS=90

# --- Optional: search on your ChatGPT plan (engine "codex") --------------------
# Opt-in like the keyed engines below, but enabled by a sign-in, not a key:
# run `search-mcp-login codex` once (or use the settings page). Each search
# counts against the plan's Codex usage. See docs/CODEX_SEARCH.md.
# SEARCH_MCP_CODEX_MODEL=gpt-6-luna          # any model the plan offers
# SEARCH_MCP_CODEX_TIMEOUT=60                # seconds per search
# SEARCH_MCP_CODEX_REASONING_EFFORT=low      # only for the /responses fallback
# SEARCH_MCP_CODEX_BASE_URL=https://chatgpt.com/backend-api/codex
# SEARCH_MCP_CODEX_AUTO_SIGNIN=true          # open the sign-in page on first use (stdio, desktop)
# SEARCH_MCP_CODEX_SIGNIN_WAIT_SECONDS=45    # how long one search waits for that approval

# --- Optional, manual: bring your own API key ----------------------------------
# You do not need any of this. Nothing the server selects on its own uses a
# key. These five engines are OPT-IN: one runs only when a call names it AND
# you have set your own key here (or on the local settings page). Agents never
# ask a user for a key. See docs/API_KEYS.md.
# SEARCH_MCP_BRAVE_API_KEY=          # engine "brave_api"  — brave.com/search/api
# SEARCH_MCP_SERPER_API_KEY=         # engine "serper"     — serper.dev
# SEARCH_MCP_TAVILY_API_KEY=         # engine "tavily"     — app.tavily.com
# SEARCH_MCP_GOOGLE_CSE_API_KEY=     # engine "google_cse" — needs BOTH key …
# SEARCH_MCP_GOOGLE_CSE_CX=          #                       … and the cx (engine id)
# SEARCH_MCP_GITHUB_TOKEN=           # engine "github_code"; also 10→30 req/min for "github"
# Optional credentials for engines that are already keyless (limits only):
# SEARCH_MCP_ANYSEARCH_API_KEY=      # raises anysearch rate limits
# SEARCH_MCP_STACKEXCHANGE_KEY=      # raises the 300/day keyless quota
# SEARCH_MCP_SEMANTICSCHOLAR_API_KEY=  # the anonymous pool answers 429 in
#                                      practice; a free key makes it usable
