# free-search-mcp 1.0 configuration — copy to ~/.config/search-mcp/.env (or ./.env).
# Every setting is optional; the defaults below match the compiled-in defaults.
# All variables are prefixed with SEARCH_MCP_ (plus optional CODEX_HOME).
# Comments go on their own line: a trailing `# note` after a value is read as
# part of the value unless separated by whitespace (inline `#` after space).
#
# Where settings are read (highest precedence first):
#   1. Real process environment variables
#   2. ./.env in the working directory — ORDINARY settings ONLY
#      (security-sensitive settings marked [SEC] below are IGNORED in ./.env!)
#   3. ~/.config/search-mcp/.env (override dir with SEARCH_MCP_CONFIG_DIR)
#   4. ~/.config/search-mcp/config.json (0600 — credentials, PROXY, PROXY_ENGINES)
#
# Empty values and unresolved MCPB placeholders (${...}) are treated as unset.

# --- Pools & Routing ---------------------------------------------------------
# Nothing in any default, reserve, fresh, locale, or vertical pool needs a key.
#
# JSON array: default keyless web pool. All plain HTTP. yahoojp licenses
# Google's organic index (any language; not served in the EEA/UK).
SEARCH_MCP_DEFAULT_ENGINES=["duckduckgo","bing","yahoojp","seznam"]
# Hedging reserves used when fewer than MIN_HEALTHY_ENGINES answer or primary fails.
SEARCH_MCP_RESERVE_ENGINES=["yahoo","youcom","mwmbl"]
SEARCH_MCP_MIN_HEALTHY_ENGINES=3
# Joined automatically for freshness="day"|"week".
SEARCH_MCP_FRESH_ENGINES=["googlenews"]
# JSON object: joined when the query script matches the language.
SEARCH_MCP_LOCALE_ENGINES={"zh":["so360","quark","baidu"],"ko":["naver","daum"]}
SEARCH_MCP_MAX_RESULTS_PER_ENGINE=10
# Max scope-native sources added when `scope=` is passed (replaces CATEGORY_ENGINE_LIMIT).
SEARCH_MCP_SCOPE_ENGINE_LIMIT=3
# Auto-route direct-fact claimants (PyPI, npm, crates, CVE, FX, weather, clock...)
# on scope="web" and scope="code".
SEARCH_MCP_AUTO_ROUTE_ENABLED=true
SEARCH_MCP_CLAIM_ENGINE_LIMIT=3
# Hedged reserve dispatch when primary engines are slow or fail (replaces RESCUE_ENABLED).
SEARCH_MCP_HEDGE_ENABLED=true

# --- Health, Coherence & Timeouts --------------------------------------------
SEARCH_MCP_HEALTH_ENABLED=true
SEARCH_MCP_ENGINE_COOLDOWN_SECONDS=600
SEARCH_MCP_ENGINE_COOLDOWN_MAX_SECONDS=3600
# Drops off-topic web decoy buckets (CJK-aware coherence guard).
SEARCH_MCP_COHERENCE_GUARD_ENABLED=true
# Hard search deadline in seconds (clamped to (0, 8.0]).
SEARCH_MCP_SEARCH_DEADLINE_SECONDS=8
SEARCH_MCP_REQUEST_TIMEOUT=5.0
SEARCH_MCP_FETCH_TIMEOUT=25.0
SEARCH_MCP_RATE_LIMIT_PER_MINUTE=30
SEARCH_MCP_FETCH_RATE_LIMIT_PER_MINUTE=20

# --- Cache & Scholar Offline Sync --------------------------------------------
# SQLite database is stored at <CACHE_DIR>/search-mcp.sqlite (coexists beside
# legacy v0.18.x cache.sqlite without modifying it).
# SEARCH_MCP_CACHE_DIR=~/.cache/search-mcp
# 7 days default (recency/news/weather/FX/software/security expire sooner).
SEARCH_MCP_CACHE_TTL_SECONDS=604800
# Max SQLite cache size in MB (0 disables eviction).
SEARCH_MCP_CACHE_MAX_MB=512
# Lazy Crossref Retraction Watch sync (~70 MB CSV downloaded on first scholar
# call, ~8-12 MB indexed in SQLite, CSV deleted, ETag-refreshed every 7 days).
# Set false to opt out and use online Crossref checks only.
SEARCH_MCP_OFFLINE_SYNC=true

# --- Locale, UA & Content Limits ---------------------------------------------
# strict | moderate | off
SEARCH_MCP_SAFESEARCH=moderate
# 'cc-lang' token, e.g. us-en, uk-en, cn-zh
SEARCH_MCP_REGION=us-en
SEARCH_MCP_ACCEPT_LANGUAGE=en-US,en;q=0.9
# Optional polite-pool email for Crossref, OpenAlex, NCBI, and Unpaywall OA full text.
# Unpaywall is skipped when unset.
# SEARCH_MCP_CONTACT_EMAIL=you@example.com
# Empty (default) keeps the Chrome emulation profile's own consistent UA.
# Plain API transport always sends its fixed honest UA (free-search-mcp/1.0).
# SEARCH_MCP_USER_AGENT=
# Background H2 warmup on startup.
SEARCH_MCP_PREWARM=true
# Per-page Markdown truncation limit in web.fetch (full text remains in cache).
SEARCH_MCP_MAX_CONTENT_CHARS=50000
# Mapped to RUST_LOG: ERROR | WARN | INFO | DEBUG | TRACE
SEARCH_MCP_LOG_LEVEL=INFO

# --- Transport & Streamable HTTP ---------------------------------------------
# stdio (default) | streamable-http
SEARCH_MCP_TRANSPORT=stdio
# Binds loopback only by default. Never expose without SEARCH_MCP_HTTP_TOKEN or a proxy.
# Streamable HTTP also exposes POST/GET /v1/ask behind the same token/host guards.
SEARCH_MCP_HTTP_HOST=127.0.0.1
SEARCH_MCP_HTTP_PORT=8000
SEARCH_MCP_HTTP_PATH=/mcp
# [SEC] Extra allowed Origin headers for browser HTTP clients (comma/space separated).
# SEARCH_MCP_HTTP_ALLOWED_ORIGINS=
# [SEC] Optional Bearer token required on Streamable HTTP & /v1/ask requests.
# SEARCH_MCP_HTTP_TOKEN=
# Optional per-process tool call cap (0 = unlimited).
SEARCH_MCP_TOOL_CALL_BUDGET=0

# --- Sandboxed `exec` Limits & Guardrails ------------------------------------
# Ceiling for per-call exec timeout_s (seconds, clamped to 1..=120).
SEARCH_MCP_EXEC_TIMEOUT_S=120
# Max Host API calls per exec invocation (clamped to 1..=300).
SEARCH_MCP_EXEC_MAX_HOST_CALLS=100
# QuickJS-NG heap limit in MiB (clamped to 16..=128).
SEARCH_MCP_EXEC_HEAP_MB=96
# [SEC] web.request policy: get-post | get-only | off.
# Automatically downgraded to get-only when SEARCH_MCP_DOCUMENT_ROOT is set
# unless explicitly overridden here.
# SEARCH_MCP_EXEC_RAW_HTTP=get-post
# [SEC] Host allowlist permitted to receive auth/cookie headers in web.request (default empty).
# SEARCH_MCP_EXEC_AUTH_HOSTS=

# --- Optional: Answer Agent (`ask` mode="agent"/"auto" & `search` answer) ----
# `ask` is always registered. With SEARCH_MCP_AGENT_BACKEND=off (default),
# `ask(..., mode="auto")` runs in keyless `fast` mode (no LLM: direct-answer
# sources first, else search + parallel page read in ~8 s). Set a backend to
# enable synthesized sourced answers in `ask` and (optionally) above `search`
# results. See docs/DELEGATION.md.
#   off          no LLM (default; `ask` uses fast mode)
#   api          any OpenAI- or Anthropic-compatible HTTP endpoint (including Ollama)
#   claude-code  one headless `claude -p` run on your Claude Code login
#   codex        one `codex exec` run in a read-only sandbox
# SEARCH_MCP_AGENT_BACKEND=off
# SEARCH_MCP_AGENT_MODEL=                 # required for api; empty = haiku / Codex CLI default
# SEARCH_MCP_AGENT_API_PROTOCOL=openai    # openai | anthropic
# SEARCH_MCP_AGENT_API_BASE_URL=          # e.g. http://localhost:11434/v1 (Ollama, no key)
# [SEC] Credential for SEARCH_MCP_AGENT_API_BASE_URL, if it requires one.
# SEARCH_MCP_AGENT_API_KEY=
# SEARCH_MCP_AGENT_COMMAND=               # full path of claude / codex when PATH is short
# SEARCH_MCP_AGENT_CLI_ARGS=              # replaces default flags; for Codex keep --ignore-user-config
# SEARCH_MCP_AGENT_DEPTH=3                # pages read before the model is called
# SEARCH_MCP_AGENT_READ_SECONDS=8         # wall budget those reads share
# SEARCH_MCP_AGENT_MAX_STEPS=1            # follow-up tool rounds after seed pages (0 = seed only)
# SEARCH_MCP_AGENT_MAX_SOURCE_CHARS=6000
# SEARCH_MCP_AGENT_TIMEOUT_SECONDS=90
# SEARCH_MCP_AGENT_IN_SEARCH=true         # also show an answer above search results when backend is set
# SEARCH_MCP_AGENT_SEARCH_TIMEOUT_SECONDS=45

# --- Optional: Agent Lane & ChatGPT Plan Search (engine "codex") -------------
# Enabled by a sign-in, not a key: run `free-search-mcp login codex` once.
# Each search counts against your ChatGPT plan's Codex usage. See docs/CODEX_SEARCH.md.
#
# Signed-in agent engines join automatic searches beside the keyless pool:
#   auto = signed-in codex only (antigravity is NEVER seated by auto)
#   off  = only when a call explicitly names them in `sources`
#   or an explicit list such as `codex,antigravity`
# SEARCH_MCP_AGENT_ENGINES=auto
# Max seconds a search waits for the agent lane (counted from fan-out start).
# SEARCH_MCP_AGENT_LANE_WAIT_SECONDS=6
# Extra grace seconds after keyless engines return results.
# SEARCH_MCP_AGENT_LANE_GRACE_SECONDS=2
# SEARCH_MCP_CODEX_MODEL=latest           # latest follows plan catalogue; or pin a model name
# SEARCH_MCP_CODEX_TIMEOUT=60             # seconds per codex search
# SEARCH_MCP_CODEX_REASONING_EFFORT=low   # low | medium | high (used only for /responses fallback)
# SEARCH_MCP_CODEX_BASE_URL=https://chatgpt.com/backend-api/codex
# SEARCH_MCP_CODEX_AUTO_SIGNIN=true       # open local browser sign-in on first explicit use (stdio desktop)
# SEARCH_MCP_CODEX_SIGNIN_WAIT_SECONDS=45
# Optional Codex CLI config directory for `free-search-mcp login codex --use-codex-cli` (read-only):
# CODEX_HOME=~/.codex

# --- Optional, At Your Own Risk: Google Search on Antigravity Sign-In --------
# Engine "antigravity". Google's Antigravity terms forbid third-party OAuth use
# and Google has suspended accounts (including Gemini CLI) for it. Never opens
# sign-in by itself and never joins `auto`. Enable only via
# `free-search-mcp login antigravity`. See docs/ANTIGRAVITY_SEARCH.md first.
# SEARCH_MCP_ANTIGRAVITY_MODEL=latest     # latest follows account catalogue; or pin a model name
# SEARCH_MCP_ANTIGRAVITY_TIMEOUT=60       # seconds per antigravity search
# SEARCH_MCP_ANTIGRAVITY_VERSION=2.1.4    # Antigravity release named in User-Agent
# SEARCH_MCP_ANTIGRAVITY_BASE_URLS=["https://daily-cloudcode-pa.sandbox.googleapis.com","https://cloudcode-pa.googleapis.com"]
# Antigravity's OAuth client (blank = read from local Antigravity install; set both on headless hosts):
# SEARCH_MCP_ANTIGRAVITY_CLIENT_ID=
# [SEC] Antigravity OAuth client secret (set together with CLIENT_ID only where needed):
# SEARCH_MCP_ANTIGRAVITY_CLIENT_SECRET=

# --- Proxy & SSRF Guard ------------------------------------------------------
# [SEC] Config dir override (default ~/.config/search-mcp).
# SEARCH_MCP_CONFIG_DIR=~/.config/search-mcp
# [SEC] Outbound proxy: http://, https://, socks5://, or socks5h:// (optional user:pass@).
# SEARCH_MCP_PROXY=
# [SEC] Optional list of source IDs to route through the proxy (blank = all sources).
# SEARCH_MCP_PROXY_ENGINES=
# Comma/space-separated host suffixes that bypass SEARCH_MCP_PROXY.
# SEARCH_MCP_NO_PROXY=localhost,.internal
# [SEC] SSRF DNS resolution mode: auto | always | never.
# auto skips L4 DNS checks behind an outbound proxy or fake-IP VPN (Clash/Surge/sing-box TUN).
SEARCH_MCP_SSRF_RESOLVE_ADDRESSES=auto
# [SEC] Escape hatch: disables private/loopback/metadata IP blocking. Leave false.
SEARCH_MCP_ALLOW_PRIVATE_HOSTS=false

# --- Documents & Downloads ---------------------------------------------------
# [SEC] Opt-in root directory for local doc.read / doc.outline calls.
# Reading a local file taints that exec call and refuses subsequent network egress.
# SEARCH_MCP_DOCUMENT_ROOT=
# [SEC] Enable/disable web.download.
SEARCH_MCP_DOWNLOAD_ENABLED=true
# [SEC] Override download directory (default <CACHE_DIR>/downloads).
# SEARCH_MCP_DOWNLOAD_DIR=
SEARCH_MCP_DOWNLOAD_TTL_HOURS=24
SEARCH_MCP_DOWNLOAD_MAX_MB=100
# [SEC] Total directory cap across all saved downloads in MB.
SEARCH_MCP_DOWNLOAD_DIR_MAX_MB=500
SEARCH_MCP_MAX_RESPONSE_BYTES=25000000
SEARCH_MCP_MAX_PDF_PAGES=200
SEARCH_MCP_MAX_DOCUMENT_CHARS=2000000

# --- Fetch Strategy (Browser rendering is P1) --------------------------------
# auto | http (browser is accepted with a P1 notice and falls back to http in 1.0)
SEARCH_MCP_FETCH_STRATEGY=auto

# --- Optional, Manual Credentials ([SEC] — NEVER put in CWD ./.env) ----------
# Nothing the server selects automatically requires a key. Agents must never
# ask you for a key. Set any optional key in the real environment or in
# ~/.config/search-mcp/.env or ~/.config/search-mcp/config.json (0600).
# See docs/API_KEYS.md for details.
#
# Opt-in search APIs (run only when named in `sources=[...]`):
# SEARCH_MCP_BRAVE_API_KEY=
# SEARCH_MCP_SERPER_API_KEY=
# SEARCH_MCP_SERPBASE_API_KEY=
# SEARCH_MCP_TAVILY_API_KEY=
# SEARCH_MCP_ANYSEARCH_API_KEY=
#
# Optional credentials that raise limits or unlock authenticated search pools:
# SEARCH_MCP_GITHUB_TOKEN=             # raises github 10->30 rpm; enables github_code
# SEARCH_MCP_STACKEXCHANGE_KEY=        # raises keyless 300/day quota
# SEARCH_MCP_SEMANTICSCHOLAR_API_KEY=  # unlocks S2 search pool (keyless single-ID already works)
# SEARCH_MCP_OPENALEX_API_KEY=         # enables OpenAlex search endpoints (single-ID works keyless)
# SEARCH_MCP_CORE_API_KEY=             # unlocks CORE v3 search pool (fulltext step 9 works keyless)
# SEARCH_MCP_NCBI_API_KEY=             # raises NCBI/PubMed rate limit from 3 to 10 req/s
# SEARCH_MCP_ADS_API_KEY=              # unlocks NASA ADS astrophysics search
# SEARCH_MCP_OPENAQ_API_KEY=           # unlocks OpenAQ v3 air quality API
