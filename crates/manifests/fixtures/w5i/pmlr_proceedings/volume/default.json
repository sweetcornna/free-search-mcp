\n<div id=\"sectionnav\">\n  <p>\n  <label for=\"search-authors\">Filter Authors:</label>\n  <input type=\"search\" name=\"filter-authors\" id=\"search-authors\" value />\n  <label for=\"search-titles\">Filter Titles:</label>\n  <input type=\"search\" name=\"filter-titles\" id=\"search-titles\" value />\n  </p>\n</div>\n\n\n\n\n\n\n<div class=\"paper\">\n  <p class=\"title\">Gaussian Process Approximations of Stochastic Differential Equations</p>\n  <p class=\"details\">\n    <span class=\"authors\">Cedric Archambeau,&nbsp;Dan Cornford,&nbsp;Manfred Opper,&nbsp;John Shawe-Taylor</span>;\n    <span class=\"info\"><i>Gaussian Processes in Practice</i>, PMLR 1:1-16</span>\n  </p>\n  <p class=\"links\">\n    [<a href=\"https://proceedings.mlr.press/v1/archambeau07a.html\">abs</a>][<a href=\"http://proceedings.mlr.press/v1/archambeau07a/archambeau07a.pdf\" target=\"_blank\" onclick=\"ga('send', 'event', 'PDF Downloads', 'Download', 'http://proceedings.mlr.press/v1/archambeau07a/archambeau07a.pdf', 10);\">Download PDF</a>]</p>\n</div>\n<div class=\"paper\">\n  <p class=\"title\">Multi-class Semi-supervised Learning with the $\\epsilon$-truncated Multinomial Probit Gaussian Process</p>\n  <p class=\"details\">\n    <span class=\"authors\">Simon Rogers,&nbsp;Mark Girolami</span>;\n    <span class=\"info\"><i>Gaussian Processes in Practice</i>, PMLR 1:17-32</span>\n  </p>\n  <p class=\"links\">\n    [<a href=\"https://proceedings.mlr.press/v1/rogers07a.html\">abs</a>][<a href=\"http://proceedings.mlr.press/v1/rogers07a/rogers07a.pdf\" target=\"_blank\" onclick=\"ga('send', 'event', 'PDF Downloads', 'Download', 'http://proceedings.mlr.press/v1/rogers07a/rogers07a.pdf', 10);\">Download PDF</a>]</p>\n</div>\n<div class=\"paper\">\n  <p class=\"title\">Learning RoboCup-Keepaway with Kernels</p>\n  <p class=\"details\">\n    <span class=\"authors\">Tobias Jung,&nbsp;Daniel Polani</span>;\n    <span class=\"info\"><i>Gaussian Processes in Practice</i>, PMLR 1:33-57</span>\n  </p>\n  <p class=\"links\">\n    [<a href=\"https://proceedings.mlr.press/v1/jung07a.html\">abs</a>][<a href=\"http://proceedings.mlr.press/v1/jung07a/jung07a.pdf\" target=\"_blank\" onclick=\"ga('send', 'event', 'PDF Downloads', 'Download', 'http://proceedings.mlr.press/v1/jung07a/jung07a.pdf', 10);\">Download PDF</a>]</p>\n</div>\n<div class=\"paper\">\n  <p class=\"title\">Salient Point and Scale Detection by Minimum Likelihood</p>\n  <p class=\"details\">\n    <span class=\"authors\">Kim S. Pedersen,&nbsp;Marco Loog,&nbsp;Pieter Dorst</span>;\n    <span class=\"info\"><i>Gaussian Processes in Practice</i>, PMLR 1:59-72</span>\n  </p>\n  <p class=\"links\">\n    [<a href=\"https://proceedings.mlr.press/v1/pedersen07a.html\">abs</a>][<a href=\"http://proceedings.mlr.press/v1/pedersen07a/pedersen07a.pdf\" target=\"_blank\" onclick=\"ga('send', 'event', 'PDF Downloads', 'Download', 'http://proceedings.mlr.press/v1/pedersen07a/pedersen07a.pdf', 10);\">Download PDF</a>]</p>\n</div>\n<div class=\"paper\">\n  <p class=\"title\">Sparse Log Gaussian Processes via MCMC for Spatial Epidemiology</p>\n  <p class=\"details\">\n    <span class=\"authors\">Jarno Vanhatalo,&nbsp;Aki Vehtari</span>;\n    <span class=\"info\"><i>Gaussian Processes in Practice</i>, PMLR 1:73-89</span>\n  </p>\n  <p class=\"links\">\n    [<a href=\"https://proceedings.mlr.press/v1/vanhatalo07a.html\">abs</a>][<a href=\"http://proceedings.mlr.press/v1/vanhatalo07a/vanhatalo07a.pdf\" target=\"_blank\" onclick=\"ga('send', 'event', 'PDF Downloads', 'Download', 'http://proceedings.mlr.press/v1/vanhatalo07a/vanhatalo07a.pdf', 10);\">Download PDF</a>]</p>\n</div>\n\n\n<p class=\"rss-subscribe\">subscribe <a href=\"/v1/assets/rss/feed.xml\">via RSS</a></p>\n\n<!-- Search Widget -->\n<script src=\"//ajax.googleapis.com/ajax/libs/jquery/2.1.1/jquery.min.js\"></script>\n<script src=\"https://proceedings.mlr.press/v1/assets/js/search.js\"></script>\n\n\n\n\n\n\n\n      </div>\n    </main>\n\n\n<footer class=\"site-f