=\"2018-05-23\"/><ukm:ISBN Value=\"9780105700128\"/><ukm:UnappliedEffects><ukm:UnappliedEffect EffectId=\"id-b8c9701f301613eea48627a77aa1d082\" AffectedURI=\"http://www.legislation.gov.uk/id/ukpga/2018/12\" Notes=\"This amendment not applied to legislation.gov.uk. 2025 c. 18, s. 103 was fully brought into force before s. 119 is fully brought into force, see reg. 1(4).\" AffectingURI=\"http://www.legislation.gov.uk/id/uksi/2026/386\" AffectedNumber=\"12\" URI=\"http://www.legislation.gov.uk/id/effect/id-b8c9701f301613eea48627a77aa1d082\" AffectingNumber=\"386\" Comments=\"NB: conditional amendment: if 2025 c 18, s. 103 is fully brought into force before s. 119 is fully brought into force, this amendment has no effect - if so, set to N with Note Editor: please note there are two possible substitutions - for “Commissioner”, and “Commissioner's”, please check for both when applying the amendments\" Modified=\"2026-09-25T14:19:14Z\" AffectingProvisions=\"Sch. 2 para. 23(2)(3)\" AffectingClass=\"UnitedKingdomStatutoryInstrument\" Row=\"202\" AffectedClass=\"UnitedKingdomPublicGeneralAct\" AffectingYear=\"2026\" RequiresApplied=\"false\" AffectedYear=\"2018\" AffectedProvisions=\"s. 26(2)(f)(ai)\" AffectingEffectsExtent=\"S+A+M+E+A+S+A+F+F+E+C+T+E+D\" Type=\"word substituted\"><ukm:AffectedTitle>Data Protection Act 2018</ukm:AffectedTitle><ukm:AffectedProvisions><ukm:Section Ref=\"section-26-2-f\" URI=\"http://www.legislation.gov.uk/id/ukpga/2018/12/section/26/2/f\">s. 26(2)(f)</ukm:Section><ukm:Section Ref=\"section-26-2-ai\" URI=\"http://www.legislation.gov.uk/id/ukpga/2018/12/section/26/2/ai\" FoundRef=\"section-26\">(ai)</ukm:Section></ukm:AffectedProvisions><ukm:AffectingTitle>The Data (Use and Access) Act 2025 (Consequential Amendments and Transitional Provision) Regulations 2026</ukm:AffectingTitle><ukm:AffectingProvisions><ukm:Section Ref=\"schedule-2\" URI=\"http://www.legislation.gov.uk/id/uksi/2026/386/schedule/2\">Sch. 2 </ukm:Section><ukm:Section Ref=\"schedule-2-paragraph-23-2\" URI=\"http://www.legislation.gov.uk/id/uksi/2026/386/schedule/2/paragraph/23/2\">para. 23(2)</ukm:Section><ukm:Section Ref=\"schedule-2-paragraph-23-3\" URI=\"http://www.legislation.gov.uk/id/uksi/2026/386/schedule/2/paragraph/23/3\">(3)</ukm:Section></ukm:AffectingProvisions><ukm:Savings><ukm:Section Ref=\"regulation-1-4\" URI=\"http://www.legislation.gov.uk/id/uksi/2026/386/regulation/1/4\">reg. 1(4)</ukm:Section></ukm:Savings><ukm:CommencementAuthority><ukm:Section Ref=\"regulation-1-2\" URI=\"http://www.legislation.gov.uk/id/uksi/2026/386/regulation/1/2\">reg. 1(2)</ukm:Section></ukm:CommencementAuthority><ukm:InForceDates><ukm:InForce Prospective=\"true\" Qualification=\"\"/></ukm:InForceDates></ukm:UnappliedEffect><ukm:UnappliedEffect RequiresApplied=\"true\" Row=\"1100\" URI=\"http://www.legislation.gov.uk/id/effect/id-45b383b20d73517d1742bc35c1da4b61\" AffectedURI=\"http://www.legislation.gov.uk/id/ukpga/2018/12\" EffectId=\"id-45b383b20d73517d1742bc35c1da4b61\" AffectedYear=\"2018\" AffectingProvisions=\"Sch. 3 para. 78(3)\" AffectingURI=\"http://www.legislation.gov.uk/id/nia/2022/18\" AffectedClass=\"UnitedKingdomPublicGeneralAct\" AffectedNumber=\"12\" Modified=\"2026-02-06T16:20:16Z\" AffectedProvisions=\"Sch. 3 para. 8(1)(y)\" AffectingClass=\"NorthernIrelandAct\" AffectingYear=\"2022\" AffectingEffectsExtent=\"N.I.\" AffectingNumber=\"18\" Type=\"added\"><ukm:AffectedTitle>Data Protection Act 2018</ukm:AffectedTitle><ukm:AffectedProvisions><ukm:Section Ref=\"schedule-3\" URI=\"http://www.legislation.gov.uk/id/ukpga/2018/12/schedule/3\">Sch. 3 </ukm:Section><ukm:Section Ref=\"schedule-3-paragraph-8-1-y\" URI=\"http://www.legislation.gov.uk/id/ukpga/2018/12/schedule/3/paragraph/8/1/y\" FoundRef=\"schedule-3-paragraph-8\">para. 8(1)(y)</ukm:Section></ukm:AffectedProvisions><ukm:AffectingTitle>Adoption and Children Act (Northern Ireland) 2022</ukm:AffectingTitle><ukm:AffectingProvisions><ukm:Section Ref=\"schedule-3\" URI=\"http://www.legislation.gov.uk/id/nia/2022/18/schedule/3\">Sch. 3 </ukm:Section><ukm:Section Ref=\"schedule-3-paragraph-78-3\" URI=\"http://www.legislation.gov.uk/id/nia/2022/18/schedule/3/paragraph/78/3\">para. 78(3)</ukm:Section></ukm:AffectingProvisions><ukm:CommencementAuthority><ukm:Section Ref=\"section-160-1\" URI=\"http://www.legislation.gov.uk/id/nia/2022/18/section/160/1\">s. 160(1)</ukm:Section></ukm:CommencementAuthority><ukm:InForceDates><ukm:InForce Applied=\"false\" Prospective=\"true\" Qualification=\"\"/></ukm:InForceDates></ukm:UnappliedEffect></ukm:UnappliedEffects></ukm:PrimaryMetadata>\n\t\t\t\t\t\n\n                    \n\t\t\t\t\t\t\t\t\t<ukm:Notes><ukm:Note IdURI=\"http://www.legislation.gov.uk/id/ukpga/2018/12/notes\"/><ukm:Alternatives><ukm:Alternative URI=\"http://www.legislation.gov.uk/ukpga/2018/12/pdfs/ukpgaen_20180012_en.pdf\" Date=\"2022-01-13\" Title=\"Explanatory Note\" Size=\"1240195\"/></ukm:Alternatives>       \n\t\t\t\t\t\t\t\t</ukm:Notes> \n\t\t\t\t\t<ukm:CorrectionSlips><ukm:CorrectionSlip URI=\"http://www.legislation.gov.uk/ukpga/2018/12/pdfs/ukpgacs_20180012_en_001.pdf\" Date=\"2019-08-19\" Title=\"Correction Slip 1\" Size=\"101314\"/></ukm:CorrectionSlips><ukm:Alternatives><ukm:Alternative URI=\"http://www.legislation.gov.uk/ukpga/2018/12/pdfs/ukpga_20180012_en.pdf\" Date=\"2018-05-24\" Size=\"3060320\"/></ukm:Alternatives>\n\t\t\t\t\t\n\t\t\t\t\t<ukm:Statistics>\n\t\t\t\t\t\t\t\t\t<ukm:TotalParagraphs Value=\"1200\"/>\n\t\t\t\t\t\t\t\t\t<ukm:BodyParagraphs Value=\"264\"/>\n\t\t\t\t\t\t\t\t\t<ukm:ScheduleParagraphs Value=\"936\"/>\n\t\t\t\t\t\t\t\t\t<ukm:AttachmentParagraphs Value=\"0\"/>\n\t\t\t\t\t\t\t\t\t<ukm:TotalImages Value=\"0\"/>\n\t\t\t\t\t\t\t\t</ukm:Statistics>\n\t\t\t\t</ukm:Metadata><Primary><Body DocumentURI=\"http://www.legislation.gov.uk/ukpga/2018/12/body\" IdURI=\"http://www.legislation.gov.uk/id/ukpga/2018/12/body\" NumberOfProvisions=\"264\" RestrictExtent=\"E+W+S+N.I.\" RestrictStartDate=\"2026-09-30\"><Part DocumentURI=\"http://www.legislation.gov.uk/ukpga/2018/12/part/1\" IdURI=\"http://www.legislation.gov.uk/id/ukpga/2018/12/part/1\" NumberOfProvisions=\"3\" id=\"part-1\" RestrictStartDate=\"2026-09-30\"><Number><Strong>PART 1</Strong></Number><Title>Preliminary</Title><P1group RestrictStartDate=\"2026-09-30\"><Title>Overview</Title><P1 DocumentURI=\"http://www.legislation.gov.uk/ukpga/2018/12/section/1\" IdURI=\"http://www.legislation.gov.uk/id/ukpga/2018/12/section/1\" id=\"section-1\"><Pnumber PuncAfter=\"\"><CommentaryRef Ref=\"M_I_881dda53-b717-425e-8142-f7976a8174ac\"/>1</Pnumber><P1para><P2 DocumentURI=\"http://www.legislation.gov.uk/ukpga/2018/12/section/1/1\" IdURI=\"http://www.legislation.gov.uk/id/ukpga/2018/12/section/1/1\" id=\"section-1-1\"><Pnumber>1</Pnumber><P2para><Text>This Act makes provision about the processing of personal data.</Text></P2para></P2><P2 DocumentURI=\"http://www.legislation.gov.uk/ukpga/2018/12/section/1/2\" IdURI=\"http://www.legislation.gov.uk/id/ukpga/2018/12/section/1/2\" id=\"section-1-2\"><Pnumber>2</Pnumber><P2para><Text>Most processing of personal data is subject to the  <Substitution ChangeId=\"id-0980e055af9390b4571e201b8f8aafaa-1625128224608\" CommentaryRef=\"id-0980e055af9390b4571e201b8f8aafaa\">UK GDPR</Substitution>.</Text></P2para></P2><P2 DocumentURI=\"http://www.legislation.gov.uk/ukpga/2018/12/section/1/3\" IdURI=\"http://www.legislation.gov.uk/id/ukpga/2018/12/section/1/3\" id=\"section-1-3\"><Pnumber>3</Pnumber><P2para><Text>Part 2 supplements the  <Substitution ChangeId=\"id-29e112b63328c8a746536836db1c3966-1625128255299\" CommentaryRef=\"id-29e112b63328c8a746536836db1c3966\">UK GDPR</Substitution>.</Text></P2para></P2><P2 DocumentURI=\"http://www.legislation.gov.uk/ukpga/2018/12/section/1/4\" IdURI=\"http://www.legislation.gov.uk/id/ukpga/2018/12/section/1/4\" id=\"section-1-4\"><Pnumber>4</Pnumber><P2para><Text>Part 3 makes provision about the processing of personal data by competent authorities for law enforcement purposes <CommentaryRef Ref=\"id-9a8be2cf53d7c39ed62f2d07d32d1c20\"/>....</Text></P2para></P2><P2 DocumentURI=\"http://www.legislation.gov.uk/ukpga/2018/12/section/1/5\" IdURI=\"http://www.legislation.gov.uk/id/ukpga/2018/12/section/1/5\" id=\"section-1-5\"><Pnumber>5</Pnumber><P2para><Text>Part 4 makes provision about the processing of personal data by the intelligence services <Addition ChangeId=\"id-494dd52ba56482beabc25e56147b27ce-1763370021000\" CommentaryRef=\"id-494dd52ba56482beabc25e56147b27ce\">(and certain processing carried out by competent authorities jointly with the intelligence services)</Addition>.</Text></P2para></P2><P2 DocumentURI=\"http://www.legislation.gov.uk/ukpga/2018/12/section/1/6\" IdURI=\"http://www.legislation.gov.uk/id/ukpga/2018/12/section/1/6\" id=\"section-1-6\"><Pnumber>6</Pnumber><P2para><Text>Part 5 makes provision about the Information <Substitution ChangeId=\"id-8f5d714ca917fa486b29b58fb4e7af0e-1790587857479\" CommentaryRef=\"id-8f5d714ca917fa486b29b58fb4e7af0e\">Commission</Substitution>.</Text></P2para></P2><P2 DocumentURI=\"http://www.legislation.gov.uk/ukpga/2018/12/section/1/7\" IdURI=\"http://www.legislation.gov.uk/id/ukpga/2018/12/section/1/7\" id=\"section-1-7\"><Pnumber>7</Pnumber><P2para><Text>Part 6 makes provision about the enforcement of the data protection legislation.</Text></P2para></P2><P2 DocumentURI=\"http://www.legislation.gov.uk/ukpga/2018/12/section/1/8\" IdURI=\"http://www.legislation.gov.uk/id/ukpga/2018/12/section/1/8\" id=\"section-1-8\"><Pnumber>8</Pnumber><P2para><Text>Part 7 makes supplementary provision, including provision about the application of this Act to the Crown and to Parliament.</Text></P2para></P2></P1para></P1></P1group></Part></Body></Primary><Commentaries><Commentary id=\"id-0980e055af9390b4571e201b8f8aafaa\" Type=\"F\"><Para><Text>Words in s. 1(2) substituted (31.12.2020) by <Citation URI=\"http://www.legislation.gov.uk/id/uksi/2019/419\" id=\"c86yjg0z4-00007\" Class=\"UnitedKingdomStatutoryInstrument\" Year=\"2019\" Number=\"419\" Title=\"The Data Protection, Privacy and Electronic Communications (Amendments etc) (EU Exit) Regulations 2019\">The Data Protection, Privacy and Electronic Communications (Amendments etc) (EU Exit) Regulations 2019 (S.I. 2019/419)</Citation>, <CitationSubRef CitationRef=\"c86yjg0z4-00007\" id=\"c86yjg0z4-00008\" SectionRef=\"regulation-1-2\" URI=\"http://www.legislation.gov.uk/id/uksi/2019/419/regulation/1/2\">reg. 1(2)</CitationSubRef>, <CitationSubRef CitationRef=\"c86yjg0z4-00007\" id=\"c86yjg0z4-00009\" SectionRef=\"schedule-2-paragraph-2-2\" URI=\"http://www.legislation.gov.uk/id/uksi/2019/419/schedule/2/paragraph/2/2\" Operative=\"true\">Sch. 2 para. 2(2)</CitationSubRef> (with <CitationSubRef CitationRef=\"c86yjg0z4-00007\" id=\"c86yjg0z4-00010\" SectionRef=\"regulation-5\" URI=\"http://www.legislation.gov.uk/id/uksi/2019/419/regulation/5\">reg. 5</CitationSubRef>); <Citation URI=\"http://www.legislation.gov.uk/id/ukpga/2020/1\" id=\"c86yjg0z4-00011\" Year=\"2020\" Class=\"UnitedKingdomPublicGeneralAct\" Number=\"1\">2020 c. 1</Citation>, <CitationSubRef CitationRef=\"c86yjg0z4-00011\" id=\"c86yjg0z4-00012\" URI=\"http://www.legislation.gov.uk/id/ukpga/2020/1/schedule/5/paragraph/1/1\" SectionRef=\"schedule-5-paragraph-1-1\">Sch. 5 para. 1(1)</CitationSubRef></Text></Para></Commentary><Commentary id=\"id-29e112b63328c8a746536836db1c3966\" Type=\"F\"><Para><Text>Words in s. 1(3) substituted (31.12.2020) by <Citation URI=\"http://www.legislation.gov.uk/id/uksi/2019/419\" id=\"c86yjg0z4-00019\" Class=\"UnitedKingdomStatutoryInstrument\" Year=\"2019\" Number=\"419\" Title=\"The Data Protection, Privacy and Electronic Communications (Amendments etc) (EU Exit) Regulations 2019\">The Data Protection, Privacy and Electronic Communications (Amendments etc) (EU Exit) Regulations 2019 (S.I. 2019/419)</Citation>, <CitationSubRef CitationRef=\"c86yjg0z4-00019\" id=\"c86yjg0z4-00020\" SectionRef=\"regulation-1-2\" URI=\"http://www.legislation.gov.uk/id/uksi/2019/419/regulation/1/2\">reg. 1(2)</CitationSubRef>, <CitationSubRef CitationRef=\"c86yjg0z4-00019\" id=\"c86yjg0z4-00021\" SectionRef=\"schedule-2-paragraph-2-3\" URI=\"http://www.legislation.gov.uk/id/uksi/2019/419/schedule/2/paragraph/2/3\" Operative=\"true\">Sch. 2 para. 2(3)</CitationSubRef> (with <CitationSubRef CitationRef=\"c86yjg0z4-00019\" id=\"c86yjg0z4-00022\" SectionRef=\"regulation-5\" URI=\"http://www.legislation.gov.uk/id/uksi/2019/419/regulation/5\">reg. 5</CitationSubRef>); <Citation URI=\"http://www.legislation.gov.uk/id/ukpga/2020/1\" id=\"c86yjg0z4-00023\" Year=\"2020\" Class=\"UnitedKingdomPublicGeneralAct\" Number=\"1\">2020 c. 1</Citation>, <CitationSubRef CitationRef=\"c86yjg0z4-00023\" id=\"c86yjg0z4-00024\" URI=\"http://www.legislation.gov.uk/id/ukpga/2020/1/schedule/5/paragraph/1/1\" SectionRef=\"schedule-5-paragraph-1-1\">Sch. 5 para. 1(1)</CitationSubRef></Text></Para></Commentary><Commentary id=\"id-494dd52ba56482beabc25e56147b27ce\" Type=\"F\"><Para><Text>Words in <CitationSubRef id=\"czp61n105-00006\" SectionRef=\"section-1-5\" URI=\"http://www.legislation.gov.uk/id/ukpga/2018/12/section/1/5\">s. 1(5)</CitationSubRef> inserted (17.11.2025) by <Citation URI=\"http://www.legislation.gov.uk/id/ukpga/2025/18\" id=\"czp61n105-00007\" Class=\"UnitedKingdomPublicGeneralAct\" Year=\"2025\" Number=\"18\" Title=\"Data (Use and Access) Act 2025\">Data (Use and Access) Act 2025 (c. 18)</Citation>, <CitationSubRef CitationRef=\"czp61n105-00007\" id=\"czp61n105-00008\" SectionRef=\"section-90-2\" URI=\"http://www.legislation.gov.uk/id/ukpga/2025/18/section/90/2\" Operative=\"true\">ss. 90(2)</CitationSubRef>, <CitationSubRef CitationRef=\"czp61n105-00007\" id=\"czp61n105-00009\" SectionRef=\"section-142-1\" URI=\"http://www.legislation.gov.uk/id/ukpga/2025/18/section/142/1\">142(1)</CitationSubRef>; <Citation URI=\"http://www.legislation.gov.uk/id/uksi/2025/996\" id=\"czp61n105-00010\" Class=\"UnitedKingdomSta